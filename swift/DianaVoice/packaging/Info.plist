<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>English</string>
    <key>CFBundleDisplayName</key>
    <string>Diana Voice</string>
    <key>CFBundleName</key>
    <string>Diana Voice</string>
    <key>CFBundleExecutable</key>
    <string>DianaVoice</string>
    <key>CFBundleIdentifier</key>
    <string>com.diana.voice</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>icon</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>0.1.0</string>
    <!-- Accessory app: no Dock icon, no menu bar app menu (tray-only). -->
    <key>LSUIElement</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- TCC usage string: required for voice_listen's mic capture. Without
         this (and a code signature) macOS denies mic access and STT records
         silence. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Diana Voice uses the microphone for dictation and to record your voice reference.</string>
</dict>
</plist>
